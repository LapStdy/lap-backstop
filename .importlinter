[importlinter]
root_packages =
    contracts
    core
    plugins
    storage
include_external_packages = true

[importlinter:contract:contracts-isolation]
name = contracts 不依赖内核、插件、界面与存储
type = forbidden
source_modules =
    contracts
forbidden_modules =
    core
    plugins
    web
    storage

[importlinter:contract:layers]
name = 分层单向：core → storage → contracts
type = layers
layers =
    core
    storage
    contracts

# 看门狗 → core 的禁止不在此声明：source 本身就在 core 里，重叠对会被
# import-linter 按 as_packages 直接跳过，声明形同虚设。core 其余子包与
# 允许集之外的项目内依赖由 tests/contract/test_watchdog_imports.py 拦截，
# 允许集在该测试文件唯一定义；本契约只保 storage 半边。
[importlinter:contract:watchdog-isolation]
name = 看门狗不依赖存储
type = forbidden
source_modules =
    core.hostops.watchdog
forbidden_modules =
    storage

[importlinter:contract:plugins-isolation]
name = 插件只依赖契约，不碰内核与存储
type = forbidden
source_modules =
    plugins
forbidden_modules =
    core
    storage
    web
