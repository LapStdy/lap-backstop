[importlinter]
root_packages =
    contracts
    core
    plugins
    storage
include_external_packages = true

[importlinter:contract:contracts-isolation]
name = contracts 不依赖内核、插件、界面与存储
type = forbidden
source_modules =
    contracts
forbidden_modules =
    core
    plugins
    web
    storage

[importlinter:contract:layers]
name = 分层单向：core → storage → contracts
type = layers
layers =
    core
    storage
    contracts

[importlinter:contract:watchdog-isolation]
name = 看门狗只用标准库，不依赖内核其余代码路径与存储
type = forbidden
source_modules =
    core.hostops.watchdog
forbidden_modules =
    core
    storage

[importlinter:contract:plugins-isolation]
name = 插件只依赖契约，不碰内核与存储
type = forbidden
source_modules =
    plugins
forbidden_modules =
    core
    storage
    web
