{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://maa/config/1",
  "x-schema-version": 1,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "maa_dir": {
      "type": "string",
      "title": "MAA 目录",
      "default": "H:/MAA"
    },
    "mode": {
      "type": "string",
      "title": "脚本模式",
      "enum": ["gui", "binding"],
      "default": "gui"
    },
    "mumu_dir": {
      "type": "string",
      "title": "MuMu 安装目录",
      "default": "H:/MuMuPlayer"
    },
    "adb_address": {
      "type": "string",
      "title": "模拟器 adb 地址",
      "default": "127.0.0.1:16384"
    },
    "emulator_window_title": {
      "type": "string",
      "title": "模拟器窗口标题子串",
      "description": "按子串匹配窗口标题，判定模拟器窗口是否存在",
      "default": "MuMu"
    },
    "game_package": {
      "type": "string",
      "title": "游戏包名",
      "description": "用于判定游戏是否在前台",
      "default": "com.hypergryph.arknights"
    },
    "screen_size": {
      "type": "string",
      "title": "游戏截图分辨率",
      "description": "游戏横屏时截图的宽x高",
      "pattern": "^[0-9]+x[0-9]+$",
      "default": "1280x720"
    },
    "mumu_instance_index": {
      "type": "integer",
      "title": "模拟器实例序号",
      "minimum": 0,
      "default": 0
    },
    "mumu_boot_timeout_s": {
      "type": "integer",
      "title": "模拟器启动到 adb 可连的上限（秒）",
      "minimum": 1,
      "default": 180
    },
    "game_launch_timeout_s": {
      "type": "integer",
      "title": "游戏启动到前台的时限（秒）",
      "minimum": 1,
      "default": 60
    },
    "page_gate": {
      "type": "boolean",
      "title": "主界面门控",
      "description": "prepare 在拉起游戏后截帧判定主界面，连续两帧确认才放行",
      "default": true
    },
    "profile": {
      "type": "string",
      "title": "MAA 配置名",
      "description": "留空时按 MAA 首次运行的配置名 Default 构造整份目标"
    },
    "tasks": {
      "type": "array",
      "title": "任务队列",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "title": "任务类型",
            "enum": [
              "StartUpTask",
              "CloseDownTask",
              "FightTask",
              "OperProgressTask",
              "AwardTask",
              "MallTask",
              "InfrastTask",
              "RecruitTask",
              "RoguelikeTask",
              "CopilotTask",
              "SSSCopilotTask",
              "SingleStepTask",
              "DepotTask",
              "OperBoxTask",
              "UserDataUpdateTask",
              "ReclamationTask",
              "DepotMaintainTask",
              "SwitchThemeTask",
              "CustomTask"
            ]
          },
          "name": {
            "type": "string",
            "title": "任务名"
          },
          "enabled": {
            "type": "boolean",
            "title": "是否启用",
            "default": true
          },
          "params": {
            "type": "object",
            "title": "任务参数",
            "additionalProperties": true
          }
        }
      }
    },
    "launch_timeout_s": {
      "type": "integer",
      "title": "启动到资源加载完成的上限（秒）",
      "minimum": 1,
      "default": 180
    },
    "wake_timeout_s": {
      "type": "integer",
      "title": "开始唤醒到主界面的上限（秒）",
      "minimum": 1,
      "default": 90
    },
    "startup_timeout_s": {
      "type": "integer",
      "title": "游戏启动到登录界面的上限（秒）",
      "minimum": 1,
      "default": 300
    },
    "sample_interval_s": {
      "type": "integer",
      "title": "运行期抽帧间隔（秒）",
      "minimum": 1,
      "default": 30
    },
    "keep_warm_minutes": {
      "type": "integer",
      "title": "运行结束后保持环境就绪的时长（分钟）",
      "minimum": 0,
      "default": 30
    },
    "config_projection": {
      "type": "object",
      "title": "配置投影",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "开跑前对账并写入",
          "default": true
        },
        "backup_keep": {
          "type": "integer",
          "title": "备份保留份数",
          "minimum": 1,
          "default": 20
        }
      }
    }
  }
}
